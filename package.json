{
  "name": "minute-mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drop in a meeting. Get minutes, decisions and a to-do list.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch-path=server server/dev.js\" \"vite\"",
    "dev:api": "node server/dev.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/test/*.test.js",
    "test:e2e": "playwright test",
    "fake-ai": "node server/dev/fake-ai.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
